# fulfill this file with your variables before running terraform
# and do not commit it to version control
# you can copy this file to terraform.tfvars and edit it there
keycloak_realm               = "cluster"
keycloak_admin_client_id     = "admin-cli"
keycloak_admin_client_secret = "admin-cli-client-secret"
keycloak_admin_url           = "https://keycloak.zone.internal"
keycloak_admin_realm         = "master"
keycloak_admin_username      = "admin-user"
keycloak_admin_password      = "admin-password"
